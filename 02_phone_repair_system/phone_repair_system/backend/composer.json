{
    "name": "laravel/phone-repair-system",
    "type": "project",
    "description": "Mobile Phone Repair Status Tracking System (Laravel 11)",
    "keywords": [
        "laravel",
        "phone-repair",
        "tracking-system"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.1 || ^8.2 || ^8.3",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "^4.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "policy.advisories.block": false,
        "platform-check": false
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}